    "ingredientsInventoryCloudWrites": 0
  },
  "technicalValidation": {
    "ingredientsInventory": {
      "manualOnly": true,
      "rounds": 3,
      "queriesPerRound": 2,
      "totalQueriesPerSession": 6,
      "maxSessionsPerDevicePerDay": 1,
      "cloudWrites": 0,
      "diagnosticsStorage": "localStorage",
      "productionObservationCredit": 0,
      "autoPromotion": false
    }
  }
}
