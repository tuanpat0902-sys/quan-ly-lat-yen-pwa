{
  "version": "3.0-zero-added-cost-3",
  "policy": "zero-added-cost",
  "paidServicesAllowed": false,
  "paidInfrastructureAllowed": false,
  "paidApiAllowed": false,
  "newSupabaseProjectAllowed": false,
  "newSupabaseBranchAllowed": false,
  "externalTelemetryAllowed": false,
  "cloudWritesForShadowDiagnostics": false,
  "allowed": {
    "supabaseExistingProjectFreeTier": true,
    "githubExistingRepositoryPagesActionsFreeUsage": true,
    "browserStorage": true,
